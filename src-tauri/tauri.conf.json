{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kast",
  "version": "0.1.0",
  "identifier": "com.kast.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/kast/browser"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "splash",
        "url": "index.html#/splash",
        "title": "Kast",
        "width": 640,
        "height": 400,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      },
      {
        "label": "main",
        "url": "index.html#/controller",
        "title": "Kast - Controlador",
        "width": 1360,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
